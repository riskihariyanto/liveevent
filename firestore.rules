rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == '999999'
        && request.auth.token.email == 'riskimarkem@gmail.com';
    }

    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    function autoMode() {
      return get(/databases/$(database)/documents/config/state).data.mode == 'auto';
    }

    function validMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'nickname', 'text', 'color', 'ts'])
        && d.keys().hasAll(['uid', 'nickname', 'text', 'color', 'ts'])
        && d.uid == request.auth.uid
        && d.nickname is string
        && d.nickname.size() > 0
        && d.nickname.size() <= 40
        && d.text is string
        && d.text.size() > 0
        && d.text.size() <= 300
        && d.color is string
        && d.color.matches('^#[0-9a-fA-F]{6}$')
        && d.ts == request.time;
    }

    function cooldownOk() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return (!exists(ref) || get(ref).data.lastChat + duration.value(3, 's') <= request.time)
        && getAfter(ref).data.lastChat == request.time;
    }

    function validEmote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'counts', 'ts'])
        && d.keys().hasAll(['uid', 'counts', 'ts'])
        && d.uid == request.auth.uid
        && d.counts is map
        && d.counts.size() > 0
        && d.counts.size() <= 6
        && d.counts.keys().hasOnly(['heart', 'fire', 'clap', 'laugh', 'wow', 'party'])
        && d.ts == request.time;
    }

    match /config/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastChat'])
        && request.resource.data.lastChat == request.time;
    }

    match /pending/{id} {
      allow create: if signedIn() && notBanned() && validMessage() && cooldownOk();
      allow read, update, delete: if isAdmin();
    }

    match /approved/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn() && notBanned() && validMessage() && cooldownOk() && autoMode());
      allow update, delete: if isAdmin();
    }

    match /emotes/{uid} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == uid
        && notBanned()
        && validEmote();
      allow update: if signedIn()
        && request.auth.uid == uid
        && notBanned()
        && validEmote()
        && resource.data.ts + duration.value(1500, 'ms') <= request.time;
      allow delete: if isAdmin();
    }
  }
}
